# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (never prefix these with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PORT=3000
NODE_ENV=production

# Appointment calendar invitations: separate from Supabase Auth SMTP.
# Keep disabled until the sender and a consenting test recipient are validated.
APPOINTMENT_INVITES_ENABLED=false
APPOINTMENT_INVITES_ORGANIZATION_ID=authorized-organization-uuid
APPOINTMENT_INVITES_UNIT_ID=authorized-unit-uuid
APPOINTMENT_SMTP_HOST=smtp.example.com
APPOINTMENT_SMTP_PORT=465
APPOINTMENT_SMTP_USER=sender@example.com
APPOINTMENT_SMTP_PASSWORD=replace-only-in-private-server-settings
APPOINTMENT_SMTP_FROM=sender@example.com

# Asaas: example account secret_reference = ASAAS_LUX_DOG_SANDBOX
# Store real values only in server environment settings, never in VITE_ variables.
ASAAS_LUX_DOG_SANDBOX_API_KEY=replace-with-sandbox-api-key
ASAAS_LUX_DOG_SANDBOX_WEBHOOK_TOKEN=replace-with-a-random-token-at-least-32-characters
