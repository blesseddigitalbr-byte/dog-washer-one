# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (never prefix these with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PORT=3000

# Asaas: example account secret_reference = ASAAS_LUX_DOG_SANDBOX
# Store real values only in server environment settings, never in VITE_ variables.
ASAAS_LUX_DOG_SANDBOX_WEBHOOK_TOKEN=replace-with-a-random-token-at-least-32-characters
